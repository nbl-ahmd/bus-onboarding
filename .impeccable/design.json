      "html": "<label class=\"ds-label\">Stop location<input class=\"ds-field\" value=\"Confirmed stop\" /></label>",
      "css": ".ds-label{display:grid;gap:7px;font:500 12px Outfit,Arial,sans-serif;color:var(--ink,#213748)}.ds-field{border:1px solid var(--line,#e4e9ef);border-radius:6px;background:var(--surface,#fff);color:var(--ink,#213748);padding:10px 11px;font:400 13px Outfit,Arial,sans-serif}.ds-field:focus-visible{outline:3px solid #56a496;outline-offset:3px}"
    },
    {
      "name": "Quick announcement",
      "kind": "card",
      "refersTo": "quick-row",
      "description": "Direct play with a separate edit action.",
      "html": "<div class=\"ds-row\"><button class=\"ds-play\">Welcome aboard <span>Play</span></button><button class=\"ds-edit\">Edit</button></div>",
      "css": ".ds-row{display:flex;border:1px solid var(--line,#e4e9ef);border-radius:12px;background:var(--surface,#fff)}.ds-row:hover{border-color:#9bbdb2}.ds-play{display:flex;justify-content:space-between;gap:20px;flex:1;background:none;border:0;padding:23px 17px;font:500 15px Outfit,Arial,sans-serif;color:var(--ink,#213748);text-align:left}.ds-play span{color:var(--brand,#197568);font-size:12px}.ds-edit{background:none;border:0;border-left:1px solid var(--line,#e4e9ef);padding:0 14px;margin:13px 4px;font:400 12px Outfit,Arial,sans-serif;color:var(--muted,#657583)}.ds-play:focus-visible{outline:3px solid #56a496;outline-offset:3px}.ds-edit:focus-visible{outline:3px solid #56a496;outline-offset:3px}"
    },
    {
      "name": "Language sequence",
      "kind": "chip",
      "refersTo": "sequence-part",
      "description": "Literal language order, not an extra play step.",
      "html": "<div class=\"ds-sequence\"><span>EN</span><i>→</i><span>ML</span><i>→</i><span>EN</span><i>→</i><span>ML</span></div>",
      "css": ".ds-sequence{display:flex;align-items:center;gap:8px;font:500 11px Outfit,Arial,sans-serif}.ds-sequence span{background:var(--brand-soft,#e9f5ef);color:var(--brand,#197568);padding:8px;border-radius:5px}.ds-sequence i{font-style:normal;color:var(--muted,#657583)}"
    },
    {
      "name": "Main navigation",
      "kind": "nav",
      "description": "Three working destinations; secondary tools in a menu.",
      "html": "<nav class=\"ds-nav\"><button aria-current=\"page\">Announcements</button><button>Trips</button><button>Audio</button></nav>",
      "css": ".ds-nav{display:flex;gap:5px}.ds-nav button{border:0;background:none;color:var(--muted,#657583);border-radius:7px;padding:10px 15px;font:400 13px Outfit,Arial,sans-serif}.ds-nav button[aria-current]{background:var(--brand-soft,#e9f5ef);color:var(--brand,#197568)}.ds-nav button:hover{background:var(--surface-muted,#f6f8fa)}.ds-nav button:focus-visible{outline:3px solid #56a496;outline-offset:3px}"
    },
    {
      "name": "Stop sequence",
      "kind": "button",
      "description": "Stops all remaining parts, including a pause.",
      "html": "<button class=\"ds-stop\">Stop</button>",
      "css": ".ds-stop{background:var(--danger-soft,#fff0f0);color:var(--danger,#af4145);border:0;border-radius:7px;padding:12px 18px;font:500 13px Outfit,Arial,sans-serif}.ds-stop:hover{filter:brightness(.96)}.ds-stop:focus-visible{outline:3px solid #56a496;outline-offset:3px}"
    }
  ],
