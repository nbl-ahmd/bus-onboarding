# Optional: the app runs locally without external services.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only, required solely for creating driver accounts from the fleet screen.
SUPABASE_SERVICE_ROLE_KEY=
# Server only. Select a TTS model available in your Google AI Studio free tier.
GEMINI_API_KEY=
# Live uses the same server key and short-lived browser tokens.
GEMINI_LIVE_MODEL=gemini-3.8-live
# Dedicated TTS remains an alternative with its own quota.
GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts
GEMINI_TTS_VOICE=Kore
# If using Gemini without Supabase, set a strong shared pilot access code (12+ chars).
PILOT_ACCESS_CODE=
# A public support URL or email identifying your app to MET Norway.
WEATHER_CONTACT=
